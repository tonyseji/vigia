# Copiar a .env y rellenar. El .env real NUNCA se commitea (repo publico).
# Estas dos claves son publicas por diseno: la publishable key solo sirve
# acompanada de una sesion valida, porque RLS filtra por usuario.
# Publishable key moderna (sb_publishable_...), no el anon key JWT legado:
# Project Settings > API Keys en el dashboard de Supabase.
VITE_SUPABASE_URL=https://ovmnzlbcmuppqctkyngi.supabase.co
VITE_SUPABASE_ANON_KEY=

# Clave publica VAPID (Web Push). Publica por diseno, igual que la anon key:
# npx web-push generate-vapid-keys --json genera el par; la privada va SOLO
# en Supabase Secrets, nunca aqui. Ver docs/DECISIONES.md 2026-09-06.
VITE_VAPID_PUBLIC_KEY=
