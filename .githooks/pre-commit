#!/bin/sh
# Guardia anti-secretos para un repositorio publico.
# Activar una sola vez:  git config core.hooksPath .githooks
# Saltar puntualmente:   git commit --no-verify

fallos=0
q="'"

patrones="eyJ[A-Za-z0-9_-]{30,}|sb_secret_[A-Za-z0-9]{10,}|service_role[[:space:]]*[:=][[:space:]]*[\"$q][^\"$q]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{20,}"

for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    package-lock.json|*.min.js|*.lock|.githooks/*) continue ;;
  esac
  if git show ":$f" 2>/dev/null | grep -qE "$patrones"; then
    echo "  x posible credencial en $f"
    fallos=1
  fi
done

for f in $(git diff --cached --name-only --diff-filter=ACM); do
  [ "$f" = ".env.example" ] && continue
  case "$f" in
    .env|.env.*|*.pem|*.key|*.p12|*.dump|*.sql.gz)
      echo "  x archivo que no debe publicarse: $f"
      fallos=1
      ;;
  esac
done

if [ "$fallos" -ne 0 ]; then
  echo ""
  echo "Commit detenido: este repositorio es publico."
  echo "Revisa lo de arriba. Si es un falso positivo: git commit --no-verify"
  exit 1
fi
exit 0
